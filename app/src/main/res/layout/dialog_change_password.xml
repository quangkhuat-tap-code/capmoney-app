<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card"
    android:orientation="vertical"
    android:padding="@dimen/spacing_large">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:text="@string/password_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_size_title"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/password_layout_current"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundColor="@color/bg_card_secondary"
        app:boxBackgroundMode="filled"
        app:boxCornerRadiusBottomEnd="@dimen/corner_radius_small"
        app:boxCornerRadiusBottomStart="@dimen/corner_radius_small"
        app:boxCornerRadiusTopEnd="@dimen/corner_radius_small"
        app:boxCornerRadiusTopStart="@dimen/corner_radius_small"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="0dp"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/text_secondary"
        app:errorEnabled="true"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/password_et_current"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:hint="@string/password_hint_current"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:maxLength="72"
            android:maxLines="1"
            android:paddingStart="@dimen/spacing_medium"
            android:paddingTop="0dp"
            android:paddingEnd="@dimen/spacing_medium"
            android:paddingBottom="0dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/password_layout_new"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundColor="@color/bg_card_secondary"
        app:boxBackgroundMode="filled"
        app:boxCornerRadiusBottomEnd="@dimen/corner_radius_small"
        app:boxCornerRadiusBottomStart="@dimen/corner_radius_small"
        app:boxCornerRadiusTopEnd="@dimen/corner_radius_small"
        app:boxCornerRadiusTopStart="@dimen/corner_radius_small"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="0dp"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/text_secondary"
        app:errorEnabled="true"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/password_et_new"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:hint="@string/password_hint_new"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:maxLength="72"
            android:maxLines="1"
            android:paddingStart="@dimen/spacing_medium"
            android:paddingTop="0dp"
            android:paddingEnd="@dimen/spacing_medium"
            android:paddingBottom="0dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/password_layout_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundColor="@color/bg_card_secondary"
        app:boxBackgroundMode="filled"
        app:boxCornerRadiusBottomEnd="@dimen/corner_radius_small"
        app:boxCornerRadiusBottomStart="@dimen/corner_radius_small"
        app:boxCornerRadiusTopEnd="@dimen/corner_radius_small"
        app:boxCornerRadiusTopStart="@dimen/corner_radius_small"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="0dp"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/text_secondary"
        app:errorEnabled="true"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/password_et_confirm"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:hint="@string/password_hint_confirm"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:maxLength="72"
            android:maxLines="1"
            android:paddingStart="@dimen/spacing_medium"
            android:paddingTop="0dp"
            android:paddingEnd="@dimen/spacing_medium"
            android:paddingBottom="0dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/password_btn_cancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="@dimen/spacing_small"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/common_cancel"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:cornerRadius="@dimen/corner_radius_pill"
            app:strokeColor="@color/text_secondary" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/password_btn_save"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/common_save"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/color_accent"
                app:cornerRadius="@dimen/corner_radius_pill" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/password_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/white"
                app:indicatorSize="24dp"
                app:trackColor="@color/transparent" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>

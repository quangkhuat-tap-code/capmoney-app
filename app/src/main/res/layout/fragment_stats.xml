<?xml version="1.0" encoding="utf-8"?>
<!-- Tab Thong ke (Phan 3). Goc la FrameLayout de nhan padding inset status bar,
     ben trong NestedScrollView boc toan bo noi dung. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/stats_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/stats_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="88dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_medium"
            android:paddingEnd="@dimen/spacing_medium">

            <TextView
                android:id="@+id/stats_tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/stats_title"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Thanh chon thang -->
            <LinearLayout
                android:id="@+id/stats_layout_month_selector"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/stats_btn_prev_month"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Tháng trước"
                    android:src="@drawable/ic_chevron_left_24" />

                <TextView
                    android:id="@+id/stats_tv_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_medium"
                    android:layout_marginEnd="@dimen/spacing_medium"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_title"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/stats_btn_next_month"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Tháng sau"
                    android:src="@drawable/ic_chevron_right_24" />
            </LinearLayout>

            <!-- Chi tieu / Thu nhap -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/stats_toggle_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:checkedButton="@+id/stats_btn_expense"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stats_btn_expense"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/stats_tab_expense"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/color_expense"
                    app:strokeColor="@color/color_expense" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stats_btn_income"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/stats_tab_income"
                    android:textColor="@color/text_secondary"
                    app:backgroundTint="@color/bg_card"
                    app:strokeColor="@color/bg_card_secondary" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/stats_tv_summary_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_body"
                android:visibility="gone" />

            <!-- Banner offline: dang xem du lieu da luu trong Room -->
            <LinearLayout
                android:id="@+id/stats_layout_offline_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_stats_offline_banner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠"
                    android:textColor="@color/color_warning"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/stats_tv_offline_banner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:textColor="@color/color_warning"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Thanh tai du lieu -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/stats_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/color_accent"
                app:trackColor="@color/transparent" />

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/stats_pie_chart"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/stats_rv_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <!-- Rong -->
            <LinearLayout
                android:id="@+id/stats_layout_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="48dp"
                android:paddingBottom="@dimen/spacing_large"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊"
                    android:textSize="48sp" />

                <TextView
                    android:id="@+id/stats_tv_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body" />
            </LinearLayout>

            <!-- Loi -->
            <LinearLayout
                android:id="@+id/stats_layout_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="48dp"
                android:paddingBottom="@dimen/spacing_large"
                android:visibility="gone">

                <TextView
                    android:id="@+id/stats_tv_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stats_btn_retry"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:text="@string/stats_retry"
                    android:textColor="@color/color_accent"
                    app:cornerRadius="@dimen/corner_radius_pill"
                    app:strokeColor="@color/color_accent" />
            </LinearLayout>

            <!-- Bieu do Chi/Thu 6 thang (4C-1) -->
            <LinearLayout
                android:id="@+id/trend_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:background="@drawable/bg_trend_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/trend_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_body"
                    android:textStyle="bold" />

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/trend_bar_chart"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="@dimen/spacing_small" />

                <TextView
                    android:id="@+id/trend_tv_selected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_small"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/trend_tv_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>

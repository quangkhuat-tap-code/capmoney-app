<?xml version="1.0" encoding="utf-8"?>
<com.example.comgroupcapmoney.ui.home.SquareFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="2dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="@color/bg_card_secondary"
        app:cardCornerRadius="@dimen/corner_radius_small"
        app:strokeWidth="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/iv_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tv_placeholder_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="36sp"
                android:visibility="gone" />

            <!-- Amount label at bottom left -->
            <TextView
                android:id="@+id/tv_amount_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="6dp"
                android:background="@drawable/bg_photo_amount_label"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:textColor="@color/color_expense"
                android:textSize="@dimen/text_size_small"
                android:textStyle="bold" />

            <!-- Category badge at top right (only when photo is present) -->
            <TextView
                android:id="@+id/tv_category_badge"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/bg_photo_amount_label"
                android:gravity="center"
                android:textSize="14sp"
                android:visibility="gone" />

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</com.example.comgroupcapmoney.ui.home.SquareFrameLayout>
